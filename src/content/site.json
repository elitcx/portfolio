    },
    "about.bio2": {
      "en": "Whether crafting clean frontends or tackling competitive programming, **I'm always eager to learn, build, and grow.**",
      "id": "Baik saat merancang frontend yang rapi maupun mengerjakan soal pemrograman kompetitif, **saya selalu ingin belajar, membangun, dan berkembang.**"
    },
