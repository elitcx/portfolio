    "about.heading": {
      "en": "Hi, I'm Kenneth\nJehezkiel M.W.",
      "id": "Halo, saya Kenneth\nJehezkiel M.W."
    },
    "about.bio1": {
      "en": "I'm a **{age}-year-old student at SMA Regina Pacis Surakarta**, passionate about **Software Engineering and Development**. I love turning ideas into real, working applications and exploring how code can solve everyday problems.",
      "id": "Saya **siswa SMA Regina Pacis Surakarta berusia {age} tahun** yang menekuni **Software Engineering dan pengembangan aplikasi**. Saya senang mengubah ide menjadi aplikasi nyata yang benar-benar berjalan, dan mencari tahu bagaimana kode bisa menyelesaikan masalah sehari-hari."
    },
    "about.bio2": {
      "en": "Whether crafting clean frontends or tackling competitive programming, **I'm always eager to learn, build, and grow.**",
      "id": "Baik saat merancang frontend yang rapi maupun mengerjakan soal pemrograman kompetitif, **saya selalu ingin belajar, membangun, dan berkembang.**"
    },
    "about.drivesLabel": {
