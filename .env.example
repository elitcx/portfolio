# Copy to .env.local for `vercel dev`. Real values go in Vercel project settings,
# Production scope only, so preview deployments hold no secrets.
# Never commit real values or put them in a VITE_ variable.

# Fine-grained token: elitcx/portfolio only, Contents read/write, Commit statuses read, with an expiry.
GITHUB_TOKEN=
# Output of: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Long random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Key for draft translation.
GEMINI_API_KEY=
# Leave empty to write to main. Set to a test branch while trying things locally.
GITHUB_BRANCH=
